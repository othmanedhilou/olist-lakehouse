// Model: fact_sales (many) -> dim_customer, dim_product, dim_seller (one)
//        fact_sales[purchase_date_key] -> dim_date[date_key]

Revenue = SUM ( fact_sales[line_revenue] )

Orders = DISTINCTCOUNT ( fact_sales[order_id] )

Average Basket = DIVIDE ( [Revenue], [Orders] )

Freight Share % = DIVIDE ( SUM ( fact_sales[freight_value] ), [Revenue] )

Late Delivery % =
VAR delivered =
    CALCULATETABLE (
        VALUES ( fact_sales[order_id] ),
        NOT ISBLANK ( fact_sales[is_late] )
    )
VAR late =
    CALCULATETABLE (
        VALUES ( fact_sales[order_id] ),
        fact_sales[is_late] = TRUE ()
    )
RETURN
    DIVIDE ( COUNTROWS ( late ), COUNTROWS ( delivered ) )

Avg Delivery Days = AVERAGE ( fact_sales[delivery_days] )

Avg Review Score = AVERAGE ( fact_sales[review_score] )

Revenue PY =
CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Revenue YoY % = DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] )

Repeat Customer % =
VAR customers =
    ADDCOLUMNS (
        VALUES ( dim_customer[customer_unique_id] ),
        "n", CALCULATE ( DISTINCTCOUNT ( fact_sales[order_id] ) )
    )
RETURN
    DIVIDE ( COUNTROWS ( FILTER ( customers, [n] > 1 ) ), COUNTROWS ( customers ) )

Review Score Late =
CALCULATE ( [Avg Review Score], fact_sales[is_late] = TRUE () )

Review Score On Time =
CALCULATE ( [Avg Review Score], fact_sales[is_late] = FALSE () )

// ---- late delivery scores (gold.late_delivery_scores) ----

Open Orders Scored = COUNTROWS ( late_delivery_scores )

High Risk Orders =
CALCULATE ( COUNTROWS ( late_delivery_scores ), late_delivery_scores[risk_band] = "high" )

High Risk % = DIVIDE ( [High Risk Orders], [Open Orders Scored] )

Avg Late Probability = AVERAGE ( late_delivery_scores[late_probability] )
